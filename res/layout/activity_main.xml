<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔑 ใส่ Key เพื่อเข้าใช้งาน"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="กรอก Key ที่นี่"
            android:inputType="text" />

        <Button
            android:id="@+id/btnCheckKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ตรวจสอบ Key" />

        <TextView
            android:id="@+id/tvKeyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="สถานะ: ยังไม่ได้ตรวจสอบ"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔗 ใส่ URL ไฟล์สื่อ"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.com/file.mp4"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btnChooseFolder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📂 เลือกโฟลเดอร์ปลายทาง" />

        <TextView
            android:id="@+id/tvFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ยังไม่ได้เลือกโฟลเดอร์"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="📥 ดาวน์โหลด"
            android:enabled="false" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text=""
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
